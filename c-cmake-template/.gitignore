# ============================================
# CMake Build Directories (Out-of-source, recommended)
# ============================================
build/
build_*/
cmake-build-*/
out/
bin/
lib/
dist/
install/

# ============================================
# CMake Generated Files (In-source build artifacts)
# ============================================
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeScripts/
CTestTestfile.cmake
Testing/
DartConfiguration.tcl
compile_commands.json
*.cmake.tmp

# Note: CMakeLists.txt is source code, do not ignore
# Note: cmake/ directory contains hand-written Find*.cmake modules, do not ignore

# ============================================
# Compilation Intermediate Artifacts
# ============================================
*.o
*.obj
*.d
*.gch
*.pch
*.slo
*.lo

# ============================================
# Linker Artifacts
# ============================================
# Static libraries
*.a
*.lib
# Dynamic libraries
*.so
*.so.*
*.dylib
*.dll
# Executables
*.exe
*.out
*.app
*.elf
*.bin

